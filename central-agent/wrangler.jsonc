{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-chatty-central-agent-v1",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://super-chatty-jarvis-site.lostgodsgods.workers.dev",
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
