{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shrill-silence-164f",
  "main": "../src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "../jarvis",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "head_sampling_rate": 0,
      "persist": false
    }
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "super-chatty-owner-auth",
      "database_id": "cb1a54a2-eafe-4e02-8187-90c9e471edc0"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SENTINEL_PULSE", "class_name": "SentinelPulse" }
    ]
  },
  "migrations": [
    { "tag": "v1-sentinel-pulse", "new_sqlite_classes": ["SentinelPulse"] }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "272afa11c15d44bd82be38c034049564"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://super-chatty-jarvis-site.lostgodsgods.workers.dev",
    "AUTONOMOUS_RESEARCH_ENABLED": "true",
    "INTEL_CRON_ENABLED": "true",
    "GITHUB_REPOSITORY": "lostgodsgods-ops/super-chatty-jarvis",
    "CAPABILITY_SPEC_HOSTS": "",
    // Tavily is the primary provider; Worker code retains guarded public-search fallbacks.
    "SEARCH_PROVIDER_MODE": "open-source-first"
  }
}
