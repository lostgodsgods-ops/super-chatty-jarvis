{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-chatty-jarvis-site",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
